rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      // Any signed-in user can read a profile if it is complete (needed for
      // chat lists, match cards, etc.) — deleted docs are still readable so
      // the UI can render the "Deleted Account" placeholder gracefully.
      allow read: if isSignedIn() &&
        (isOwner(userId) || resource.data.registrationCompleted == true);
      // FIX: Allow list for registered users (needed for matching queries)
      allow list: if isSignedIn();
      allow create: if isOwner(userId);
      // Owners can update their own doc UNLESS the doc is already soft-deleted.
      // The owner IS allowed to set isDeleted=true (the soft-delete write itself).
      allow update: if isOwner(userId) &&
        (
          // Allow the soft-delete write (isDeleted going from false/null to true)
          request.resource.data.isDeleted == true ||
          // Allow normal updates only when the account is not yet deleted
          resource.data.get('isDeleted', false) != true
        );
      allow delete: if isOwner(userId);

      // Allow users to read/write their own trial usage metadata
      match /meta/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /interests/{interestId} {
      allow create: if isSignedIn() && request.resource.data.fromUserId == request.auth.uid;
      allow read: if isSignedIn() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
      allow update: if isSignedIn() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
      allow delete: if isSignedIn() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
    }

    match /profileViews/{viewId} {
      allow create: if isSignedIn() &&
        request.resource.data.fromUserId == request.auth.uid;
      allow read: if isSignedIn() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
      allow update: if isSignedIn() &&
        resource.data.fromUserId == request.auth.uid;
      allow delete: if isSignedIn() &&
        resource.data.fromUserId == request.auth.uid;
    }

    match /notifications/{notificationId} {
      allow create: if isSignedIn() &&
        request.resource.data.fromUserId == request.auth.uid;
      allow read, update, delete: if isSignedIn() &&
        (resource.data.toUserId == request.auth.uid || resource.data.fromUserId == request.auth.uid);
    }

    match /chats/{chatId} {
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      allow read, update: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow delete: if isSignedIn() && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow update: if false;
        allow delete: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }

    // Reports: any signed-in user can submit a report (create only).
    // Reading and deleting reports is restricted to backend/admin operations.
    match /reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reportedBy == request.auth.uid;
      allow read, update, delete: if false;
    }
  }
}
