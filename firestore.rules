rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // Primary: the unforgeable custom-claim "badge" that the backend sets when
      // an admin is created (covers Super, Support, Finance & Verification roles).
      // Fallback: the owner emails, but ONLY when the email is verified — an
      // attacker cannot verify an email they do not control, so the old
      // "any @swan-match.com signup = admin" spoofing hole is closed.
      return isSignedIn() && (
        request.auth.token.isAdmin == true ||
        (
          request.auth.token.email_verified == true && (
            request.auth.token.email == "admin@swan-match.com" ||
            request.auth.token.email == "sasikumar.s9951@gmail.com"
          )
        )
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isChatParticipant(data) {
      return isSignedIn() && request.auth.uid in data.participants;
    }

    function chatIdInvolvesUser(chatId) {
      return isSignedIn() && (
        chatId.matches('^' + request.auth.uid + '_.*') ||
        chatId.matches('.*_' + request.auth.uid + '$')
      );
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(
        ['account', 'isVerified',
         'stripeCustomerId', 'stripeSubscriptionId',
         'lastCheckoutSessionId', 'lastInvoiceId',
         'subscription', 'paymentStatus', 'customerEmail',
         'customerName', 'billingPeriodStart', 'billingPeriodEnd',
         'subscriptionPriceId', 'subscriptionName',
         'cancelAtPeriodEnd', 'premiumActivatedAt',
         'iapSource', 'iapProductId', 'iapTransactionId']
      ) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['profileApprovalStatus']) ||
        request.resource.data.profileApprovalStatus == 'pending'
      ) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verificationStatus']) ||
        request.resource.data.verificationStatus == 'pending'
      ) && (
        // Video-first redesign: the owner may submit/resubmit an intro video
        // (status -> 'pending') but only isAdmin() (admin-web's direct write)
        // may ever move it to 'approved'/'rejected'.
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['introVideoStatus']) ||
        request.resource.data.introVideoStatus == 'pending'
      ) && (
        // Rejection reason is admin-only, always — the owner never writes it,
        // not even to clear it on resubmit (resubmission only touches
        // introVideoStatus/introVideoUrl/introVideoSubmittedAt).
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['introVideoRejectionReason'])
      ) && (
        // The client (owner) may only move itself into non-paid states
        // (free / trial). Only the backend (Admin SDK, which bypasses these
        // rules) may ever set 'premium' or 'gold' — closes the free-premium
        // self-grant hole where a user wrote subscriptionPlan/Status directly.
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscriptionPlan']) ||
        request.resource.data.subscriptionPlan in ['free', 'trial']
      ) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscriptionStatus']) ||
        request.resource.data.subscriptionStatus in ['free', 'trialing', 'expired']
      )) || isAdmin();
      allow delete: if isAdmin();

      match /meta/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /securityLogs/{docId} {
        // Users can read their own logs for transparency, but they can NEVER write/update/delete them.
        // Direct writes are strictly prohibited for client apps; they are only writeable by the secure Admin backend.
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isAdmin();
      }
    }

    // ── Video-first redesign: Connect/Topic/Video/Accept gate ───────────────
    // id = sorted(senderId, receiverId).join('_') — same convention as
    // matches/chats, so the existing chatIdInvolvesUser() regex idiom is
    // reused as-is for the id-ownership check.
    match /connections/{connectionId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.senderId ||
        request.auth.uid == resource.data.receiverId ||
        isAdmin()
      );
      // Create: sender only. The doc id must actually be the sorted
      // senderId_receiverId pair (not just contain the caller's uid
      // somewhere), and status must start the lifecycle at 'pending'.
      allow create: if isSignedIn() &&
        chatIdInvolvesUser(connectionId) &&
        request.auth.uid == request.resource.data.senderId &&
        request.resource.data.receiverId is string &&
        request.resource.data.receiverId != request.auth.uid &&
        request.resource.data.status == 'pending' &&
        connectionId == (
          request.resource.data.senderId < request.resource.data.receiverId
            ? request.resource.data.senderId + '_' + request.resource.data.receiverId
            : request.resource.data.receiverId + '_' + request.resource.data.senderId
        );
      // Update: defense-in-depth backstop only — the supported path is the
      // respondToConnection callable. Only the receiver may flip a pending
      // request to accepted/declined, and only those two fields may change.
      allow update: if isSignedIn() &&
        request.auth.uid == resource.data.receiverId &&
        resource.data.status == 'pending' &&
        request.resource.data.status in ['accepted', 'declined'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedAt']);
      allow delete: if isAdmin();
    }

    // Predefined Connect-flow topics: admin-authored, client picks one at
    // random from active == true docs.
    match /topics/{topicId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /messages/{chatId} {
      allow read, write: if chatIdInvolvesUser(chatId) || isAdmin();
      match /messages/{messageId} {
        allow read, write: if chatIdInvolvesUser(chatId) || isAdmin();
      }
    }

    match /chats/{chatId} {
      allow read: if isSignedIn() && (
        (resource.data.keys().hasAll(['participants']) &&
          isChatParticipant(resource.data)) ||
        chatIdInvolvesUser(chatId) ||
        isAdmin()
      );
      // Video-first redesign: chatId === connectionId by construction, so a
      // chat may only be created once the matching connections doc has been
      // accepted. This is the only new get() call added by this rule set,
      // and it only runs on chat *creation* (rare) — not on every message
      // read/write.
      allow create: if isSignedIn() && isChatParticipant(request.resource.data) && (
        isAdmin() ||
        get(/databases/$(database)/documents/connections/$(chatId)).data.status == 'accepted'
      );
      allow update, delete: if isSignedIn() && (
        isChatParticipant(resource.data) || isAdmin()
      );
      match /messages/{messageId} {
        allow read, write: if chatIdInvolvesUser(chatId) || isAdmin();
      }
    }

    match /notifications/{docId} {
      allow read, update, delete: if isSignedIn() && (
        resource.data.toUserId == request.auth.uid || isAdmin()
      );
      allow create: if isAdmin() || (isSignedIn() &&
        request.resource.data.fromUserId == request.auth.uid &&
        request.resource.data.toUserId is string &&
        request.resource.data.toUserId != request.auth.uid);
    }

    match /reports/{reportId} {
      allow create: if isSignedIn() &&
        request.resource.data.reportedBy == request.auth.uid &&
        request.resource.data.reportedUid is string &&
        request.resource.data.reportedUid != request.auth.uid &&
        request.resource.data.keys().hasAll(['reason']) &&
        request.resource.data.reason.size() > 0;
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.reportedBy == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /config/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /profileViews/{docId} {
      allow read: if isSignedIn() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /user_lookup/{docId} {
      // Read allowed for signed-in users; writes restricted to admin/backend so
      // a regular user cannot pollute or overwrite lookup entries.
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /appeals/{appealId} {
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.keys().hasAll(['reason']) &&
        request.resource.data.reason.size() > 0;
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /admin_audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if false; // Audit logs must be created strictly by the secure server backend
      allow update, delete: if false; // Audit logs are strictly immutable and append-only
    }

    match /admin_notification_state/{adminUid} {
      allow read, write: if isAdmin() && request.auth.uid == adminUid;
    }

    match /support_queries/{queryId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }
  }
}
