rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == "sasikumar.s9951@gmail.com" ||
        request.auth.token.email == "admin@gmail.com" ||
        request.auth.token.email.matches(".*@swanmatch\\.com$")
      );
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null 
        && (request.auth.uid == userId || isAdmin());

      match /meta/{docId} {
        allow read, write: if request.auth != null 
          && (request.auth.uid == userId || isAdmin());
      }
    }

    match /likes/{userId} {
      allow read, write: if request.auth != null 
        && request.auth.uid == userId;
      match /likedUsers/{likedUserId} {
        allow read, write: if request.auth != null 
          && (request.auth.uid == userId || request.auth.uid == likedUserId);
      }
    }

    match /rejections/{userId} {
      allow read, write: if request.auth != null 
        && request.auth.uid == userId;
      match /rejectedUsers/{rejectedUserId} {
        allow read, write: if request.auth != null 
          && (request.auth.uid == userId || request.auth.uid == rejectedUserId);
      }
    }

    match /matches/{matchId} {
      allow read, write: if request.auth != null;
    }

    match /messages/{chatId} {
      allow read, write: if request.auth != null;
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    match /chats/{chatId} {
      allow read, write: if request.auth != null;
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    match /interests/{interestId} {
      allow read, write: if request.auth != null;
    }

    match /notifications/{docId} {
      allow read, write: if request.auth != null;
    }

    match /reports/{reportId} {
      allow read, write: if request.auth != null;
    }

    match /config/{configId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /profileViews/{docId} {
      allow read, write: if request.auth != null;
    }

    match /user_lookup/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
