rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/{allPaths=**} {
      // Allow users to upload their own photos
      allow write: if request.auth != null && request.auth.uid == userId;
      // Allow authenticated users to view photos (required for swipe/matching functionality)
      // App logic controls which photos are shown based on registration status and matching criteria
      allow read: if request.auth != null;
    }
    
    // Default deny for everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
