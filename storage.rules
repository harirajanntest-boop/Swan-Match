rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      // Same model as Firestore: trust the backend-set custom-claim "badge",
      // with a verified-owner-email fallback. (Also fixes the old domain typo
      // that checked @swanmatch.com instead of the real @swan-match.com.)
      return request.auth != null && (
        request.auth.token.isAdmin == true ||
        (
          request.auth.token.email_verified == true && (
            request.auth.token.email == "admin@swan-match.com" ||
            request.auth.token.email == "sasikumar.s9951@gmail.com"
          )
        )
      );
    }

    // Video-first redesign: parses the caller's uid out of a
    // sender_receiver-style id, same regex idiom as firestore.rules'
    // chatIdInvolvesUser().
    function connectionIdInvolvesUser(connectionId) {
      return request.auth != null && (
        connectionId.matches('^' + request.auth.uid + '_.*') ||
        connectionId.matches('.*_' + request.auth.uid + '$')
      );
    }

    // Intro video: the primary identity artifact shown in Discover. Public
    // (any signed-in user) read, owner-only write — mirrors profile photos.
    // Thumbnail lives on its own sibling path (not one shared
    // content-type-agnostic block) so each asset type keeps a tight
    // size/type check.
    match /intro-videos/{userId}/intro.mp4 {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 100 * 1024 * 1024
                   && request.resource.contentType.matches('video/.*');
    }

    match /intro-videos/{userId}/thumbnail.jpg {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Temporary connection-response videos: unmoderated, ephemeral,
    // single-recipient content — never publicly or generally signed-in
    // readable. Read/delete get an isAdmin() bypass (moderation); write does
    // not (admin never uploads here).
    match /temp-connection-videos/{connectionId}/{allPaths=**} {
      allow read: if connectionIdInvolvesUser(connectionId) || isAdmin();
      allow create, update: if connectionIdInvolvesUser(connectionId)
                   && request.resource.size < 100 * 1024 * 1024
                   && request.resource.contentType.matches('video/.*');
      allow delete: if connectionIdInvolvesUser(connectionId) || isAdmin();
    }

    // Client-generated thumbnail for a Connect-flow response video: same
    // participant-only access as the video itself, but image-typed and
    // capped like the intro-video thumbnail above.
    match /temp-connection-videos/{connectionId}/thumbnail.jpg {
      allow read: if connectionIdInvolvesUser(connectionId) || isAdmin();
      allow create, update: if connectionIdInvolvesUser(connectionId)
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if connectionIdInvolvesUser(connectionId) || isAdmin();
    }

    match /users/{userId} {
      match /profile/{allPaths=**} {
        // Public profile photos: Anyone authenticated can read
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId
                     && request.resource.size < 5 * 1024 * 1024
                     && request.resource.contentType.matches('image/.*');
      }
      match /verification/{allPaths=**} {
        // Sensitive verification uploads: Only owner or admin can read
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow write: if request.auth != null && request.auth.uid == userId
                     && request.resource.size < 5 * 1024 * 1024
                     && request.resource.contentType.matches('image/.*');
      }
      match /{allPaths=**} {
        // Fallback for any other user-specific uploads
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId
                     && request.resource.size < 5 * 1024 * 1024
                     && request.resource.contentType.matches('image/.*');
      }
    }
    
    // Default deny for everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
